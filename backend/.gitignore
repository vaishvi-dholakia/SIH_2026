# Python bytecode & cache
__pycache__/
*.py[cod]
*.class

# Environment files
.env
.env.local

# Database (Explicitly track geoscd.db so pre-seeded satellite data is NOT lost on git push!)
!geoscd.db

# Test & coverage
.pytest_cache/
.coverage
htmlcov/

# Scratch & temporary processing files
scratch/*.tif
scratch/*.tiff
scratch/*.png

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

frontend/node_modules/
