# ==============================================================================
# GEO-SCD Backend Environment Configuration (NTRO Problem Statement 26162)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Primary: PostgreSQL with PostGIS extension
# e.g.: postgresql://postgres:your_password@localhost:5432/geoscd
# Fallback: If PostgreSQL is unreachable or credentials are not set,
# the backend automatically falls back to SQLite with Shapely vector processing:
# sqlite:///./geoscd.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geoscd

# ------------------------------------------------------------------------------
# 2. NASA FIRMS API (Active Fire / Thermal Hotspots)
# ------------------------------------------------------------------------------
# Get your free Map Key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NASA sends the key instantly to your registered email.
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE

# ------------------------------------------------------------------------------
# 3. SENTINEL HUB / COPERNICUS (Multispectral Bands & True NDVI)
# ------------------------------------------------------------------------------
# Register for free at:
# Option A: https://services.sentinel-hub.com (User Settings -> OAuth Clients)
# Option B: Copernicus Data Space https://dataspace.copernicus.eu/
# If left empty, system runs without mock data and stores ndvi=None (ndvi_pending=True)
SENTINEL_HUB_CLIENT_ID=YOUR_SENTINEL_HUB_CLIENT_ID_HERE
SENTINEL_HUB_CLIENT_SECRET=YOUR_SENTINEL_HUB_CLIENT_SECRET_HERE

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. GEOSPATIAL PARAMETERS
# ------------------------------------------------------------------------------
DEFAULT_SAFETY_BUFFER_KM=1.0
HISTORICAL_DAYS_RANGE=60
